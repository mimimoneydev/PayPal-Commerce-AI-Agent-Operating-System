# Repository-root ignore rules. The application subtree has its own
# PayPal-Commerce-AI-Agent-OS/.gitignore for Python/Node/runtime artifacts.

# Compressed copy of the VPS upload bundle. Generated locally, never committed.
/deployment.zip

# macOS metadata
.DS_Store

# Local-only agent tooling state
.workbuddy-ai/

# Android client build intermediates. The signed APK and the debug keystore used by
# build.sh are intentional deliverables; compiler outputs and Gradle caches are not.
/Android App/.gradle/
/Android App/build/
/Android App/app/build/
/Android App/apk/*.idsig
