# Copy to .env at the repo root and add an OpenRouter key. The example APIs read this
# file after the process environment and the vertical's own .env. Never commit a real key.
OPENROUTER_API_KEY=
# Pinned OpenRouter model used for shopping, merchant, memory, and analysis calls.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_MEMORY_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_APP_NAME=PayPal Commerce AI Agent OS
# Optional attribution header sent to OpenRouter.
OPENROUTER_SITE_URL=http://localhost:3000

# Optional Channel3 catalog augmentation for the retail shopping agent. When unset or
# unavailable, the built-in catalog remains fully functional.
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
CHANNEL3_MAX_RESULTS=6
CHANNEL3_TIMEOUT_SECONDS=8

# Optional commercial UI licence keys. Trial packages run without these during the
# sponsor trial; production deployments must supply valid licences under vendor terms.
AG_STUDIO_LICENSE_KEY=
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
BRYNTUM_LICENSE_KEY=
NEXT_PUBLIC_BRYNTUM_LICENSE_KEY=

# Optional PayPal checkout. Use sandbox credentials until the complete production
# security checklist in docs/payments.md is satisfied. The secret stays server-side;
# the client id is intentionally public to PayPal's JavaScript SDK.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_BRAND_NAME=ACME
