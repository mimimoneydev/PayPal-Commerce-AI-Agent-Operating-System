# Copy to .env at the repo root and add an OpenRouter key. The example APIs read this
# file after the process environment and the vertical's own .env. Never commit a real key.
OPENROUTER_API_KEY=
# Pinned OpenRouter model used for shopping, merchant, memory, and analysis calls.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_MEMORY_MODEL=deepseek/deepseek-v4.1-flash
# Optional per-role override. The merchant portal carries a much larger prompt and tool
# list, so a faster model there shortens its turns without changing the storefront.
# Leave empty to use OPENROUTER_MODEL for both roles.
OPENROUTER_SHOPPING_MODEL=
OPENROUTER_MERCHANT_MODEL=
# Merchant turn budgets. 4096 output tokens keeps a multi-component answer from ending
# at stop_reason=max_tokens; the iteration/time caps stop one question from running 90s.
MERCHANT_MAX_TOKENS=4096
MERCHANT_MAX_TOOL_ITERATIONS=6
MERCHANT_MAX_ANALYSIS_ITERATIONS=4
MERCHANT_ANALYSIS_TIMEOUT_S=60
OPENROUTER_APP_NAME=PayPal Commerce AI Agent OS
# Optional attribution header sent to OpenRouter.
OPENROUTER_SITE_URL=http://localhost:3000

# Merchant approval mode (optional). The demo default is AI auto-approval: a compliant
# stage_* call applies its change in the same turn. To require a person's Approve click,
# set MERCHANT_REQUIRE_HOST_APPROVAL=1 and NEXT_PUBLIC_MERCHANT_AUTO_APPROVE=0.

# Optional Channel3 catalog augmentation for the retail shopping agent. When unset or
# unavailable, the built-in catalog remains fully functional.
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
CHANNEL3_MAX_RESULTS=6
CHANNEL3_TIMEOUT_SECONDS=8

# Optional commercial UI licence keys. Trial packages run without these during the
# sponsor trial; production deployments must supply valid licences under vendor terms.
AG_STUDIO_LICENSE_KEY=
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
BRYNTUM_LICENSE_KEY=
NEXT_PUBLIC_BRYNTUM_LICENSE_KEY=

# PayPal sandbox checkout is ON by default when both credentials are set. It powers the
# hosted checkout page and the agent's cap-bounded create_paypal_order tool. Use sandbox
# credentials only: the demo host refuses PAYPAL_ENVIRONMENT=live until the complete
# production checklist in docs/payments.md is satisfied. The secret stays server-side;
# the client id is intentionally public to PayPal's JavaScript SDK. Never commit real keys.
# The demo launcher prints a loud warning when these are empty; `python scripts/run_demo.py
# retail --no-paypal` is the explicit offline mode (sets COMMERCE_PAYPAL_DISABLED=1).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_BRAND_NAME=ACME
# REQUIRED whenever PayPal credentials above are set and the API is started directly
# (uvicorn / import). This is the browser-reachable origin used to build the hosted
# checkout URL. scripts/run_demo.py supplies http://localhost:<port> automatically; the
# VPS gets it from deploy/runtime.env. Without it the host refuses to start rather than
# emitting broken checkout links. Never include a trailing slash.
COMMERCE_PUBLIC_API_URL=http://localhost:8000
# COMMERCE_PUBLIC_API_URL=https://shop.mimi.money   # VPS
# Server-side hard ceiling for bounded auto-buy. A shopper's cap can only tighten it,
# never widen it; over-cap carts are refused before any PayPal order is created.
COMMERCE_MAX_ORDER_AMOUNT=250.00

# Merchant approval surface. A preview-card click first mints a short-lived, single-use
# capability (POST /api/merchant/approvals) and spends it on apply/discard, so a bare POST
# to those routes cannot move merchant state. This works with no configuration.
# For a real deployment, set this to a random secret and have an authenticating reverse
# proxy inject X-Merchant-Operator-Token on the approval routes for signed-in operators;
# the browser never holds it. Leave it empty for the public no-login demo.
COMMERCE_MERCHANT_OPERATOR_TOKEN=

# Retail storefront: demo (default), woocommerce or shopify. Native WooCommerce checkout uses
# the store's installed PayPal gateway; do not enable the separate sandbox checkout.
COMMERCE_PLATFORM=demo
COMMERCE_MERCHANT_ID=retail
WOOCOMMERCE_URL=
# Match AGENT_COMMERCE_SECRET in the store's wp-config.php (32+ random characters).
WOOCOMMERCE_BRIDGE_SECRET=

# Shopify uses native checkout; subscribe orders/paid, orders/updated and
# orders/cancelled to /webhooks/shopify/<COMMERCE_MERCHANT_ID> on the retail API.
SHOPIFY_URL=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# Durable encrypted merchant configuration and Shopify cart/receipt store.
# Install commerce-common[platform,examples]. Generate a Fernet key once, preserve
# it in your secret manager: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
COMMERCE_CONTROL_DATABASE_URL=sqlite:///commerce-control.db
# PostgreSQL: postgresql+psycopg://user:password@localhost/commerce
COMMERCE_ENCRYPTION_KEY=
COMMERCE_ADMIN_ORIGIN=https://admin.example.com
COMMERCE_REGISTRATION_CODE=
# Operator-approved WooCommerce hostnames, comma-separated; no schemes or paths.
COMMERCE_ALLOWED_WOO_HOSTS=

# Optional shared PostgreSQL payment store. Install commerce-common[payments].
# Unset uses the local SQLite demo store. Never commit a database password.
COMMERCE_PAYMENT_DATABASE_URL=
# COMMERCE_PAYMENT_DATABASE_URL=postgresql://user:password@localhost/commerce

# Partner Referrals integration for an authenticated multi-merchant host. This is
# separate from WooCommerce's PayPal plugin setup. Requires PayPal partner access.
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=
PAYPAL_ONBOARDING_RETURN_URL=
PAYPAL_TRACKING_SECRET=
